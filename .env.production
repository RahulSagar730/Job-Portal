# Production build settings (not secrets; safe to commit).

# CRA inlines its runtime chunk as an inline <script> by default, which the CSP below would
# block. Emit it as a normal file instead.
INLINE_RUNTIME_CHUNK=false

# Content-Security-Policy injected into public/index.html as a <meta> tag (GitHub Pages can't
# send response headers). Allows only this site's own scripts, the API, and data: images
# (2FA QR code, inline SVG icons). frame-src is for the Swagger page under Admin > API Docs.
# http://localhost:8081 is for the local IIS deployment: the same production build is served
# from localhost:8082 and calls the local API on :8081 (without it every API call is blocked).
REACT_APP_CSP=default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://rahulsagarindian.bsite.net http://localhost:8081; frame-src https://rahulsagarindian.bsite.net; object-src 'none'; base-uri 'self'; form-action 'self'; manifest-src 'self'

# .env.production

REACT_APP_ENV=production
#REACT_APP_API_URL=
